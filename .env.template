#=========== 🔅 REQUIRED ===========#
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Encryption keys (used for storing per-guild API keys at rest)
CRYPTO_KEY=
CRYPTO_IV=

#=========== 💾 DATABASE ===========#
# Bot connects to Postgres via this URL.
# In docker-compose this defaults to the `db` service hostname; set
# explicitly when running the bot outside the compose network.
DATABASE_URL=postgres://hans:devpass@localhost:5432/hans_db

# Used by the `db` service in docker-compose to initialise Postgres.
POSTGRES_DB=hans_db
POSTGRES_USER=hans
POSTGRES_PASSWORD=devpass

# Optional pool tuning
PGPOOL_MAX=10

#=========== 👾 BOT CONFIGURATION ===========#
BOT_GUILD_ID= # Your Discord Guild ID, the home of your Bot.
ISDEV=

#=========== 💠 PLUGINS ===========#
# SERVICES, not required but some functionality will be limited
GITHUB_API_TOKEN=
WEATHER_API= # Grab one at https://openweathermap.org/api
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
HUGGINGFACE_API_KEY=
TWITCH_SECRET=
TWITCH_CLIENT=
