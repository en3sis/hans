{
  "name": "hans",
  "version": "v2.1.2",
  "description": "An open-source Discord bot built with Discord.JS & TypeScript",
  "author": "en3sis",
  "website": "https://hans.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/en3sis/hans"
  },
  "license": "MIT",
  "main": "src/index.ts",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/utils/deploy-commands.ts && bun run src/index.ts",
    "dev": "bun run db:up && ISDEV=true bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . up -d --wait db && bun run db:migrate",
    "db:down": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . down",
    "db:reset": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . down -v && bun run db:up",
    "db:logs": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . logs -f",
    "db:psql": "docker exec -it hans-db-dev psql -U hans -d hans_db",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "infrastructure/ops/migrate-remote.sh",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:status": "bun run src/db/status.ts",
    "lint": "eslint . --fix",
    "format": "prettier --write '**/*.ts'",
    "slash": "bun run src/utils/deploy-commands.ts",
    "slash:dev": "ISDEV=true bun run src/utils/deploy-commands.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@discordjs/builders": "^1.15.0",
    "@discordjs/rest": "^2.6.3",
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tslib": "^2.9.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "cron": "^4.4.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "node-cache": "^5.1.2",
    "openai": "^7.63.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  }
}
