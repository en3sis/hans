{
  "name": "hans",
  "version": "v2.1.2",
  "description": "An open-source Discord bot built with Discord.JS & TypeScript",
  "author": "en3sis",
  "website": "https://hans.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/en3sis/hans"
  },
  "license": "MIT",
  "main": "src/index.ts",
  "scripts": {
    "start": "node build/utils/deploy-commands.js && node build/index.js",
    "dev": "yarn db:up && ISDEV=true nodemon hans",
    "build": "tsc --project ./",
    "build_dev": "rm -rf ./build && tsc --project ./",
    "db:up": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . up -d --wait db && yarn db:migrate",
    "db:down": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . down",
    "db:reset": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . down -v && yarn db:up",
    "db:logs": "docker compose -f infrastructure/compose/docker-compose.dev.yaml --project-directory . logs -f",
    "db:psql": "docker exec -it hans-db-dev psql -U hans -d hans_db",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "infrastructure/ops/migrate-remote.sh",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:status": "ts-node src/db/status.ts",
    "lint": "eslint . --fix",
    "format": "npx prettier --write '**/*.ts'",
    "slash": "yarn build && node build/utils/deploy-commands.js",
    "slash:dev": "export ISDEV=true && yarn build_dev && node build/utils/deploy-commands.js",
    "test": "jest --setupFiles dotenv/config"
  },
  "devDependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.1",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.202",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/sentiment": "^5.0.4",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.0.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@huggingface/inference": "^3.1.6",
    "@types/node-schedule": "^2.1.6",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.0",
    "cron": "^3.1.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.0.2",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.17.21",
    "node-cache": "^5.1.2",
    "openai": "^4.82.0",
    "pg": "^8.20.0",
    "redis": "^4.6.8",
    "sentiment": "^5.0.2",
    "socket.io-client": "^4.5.1",
    "ts-jest": "^29.1.1",
    "uuid": "^11.1.0"
  }
}
