{
  "name": "hans",
  "version": "v3.0.0",
  "description": "An open-source Discord bot built with Discord.JS & TypeScript",
  "author": "en3sis",
  "website": "https://hans.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/en3sis/hans"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run build/utils/migrate.js && bun run build/utils/deploy-commands.js && bun run build/index.js",
    "dev": "docker-compose -f docker-compose.dev.yaml up -d --wait && bun run db:migrate && ISDEV=true bun --watch src/index.ts",
    "build": "tsc --project ./",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:dev": "rm -rf ./build && tsc --project ./",
    "lint": "eslint . --fix",
    "format": "bunx prettier --write '**/*.ts'",
    "slash": "bun run build && bun run build/utils/deploy-commands.js",
    "slash:dev": "ISDEV=true bun run build:dev && bun run build/utils/deploy-commands.js",
    "test": "bun test"
  },
  "devDependencies": {
    "@discordjs/rest": "^2.0.1",
    "@types/bun": "latest",
    "@types/lodash": "^4.14.202",
    "@types/node": "^24.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/sentiment": "^5.0.4",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.0.3",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.5",
    "@types/node-schedule": "^2.1.6",
    "@types/uuid": "^11.0.0",
    "axios": "^1.6.0",
    "cron": "^4.3.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.13.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "lodash": "^4.17.21",
    "node-cache": "^5.1.2",
    "openai": "^6.10.0",
    "postgres": "^3.4.7",
    "redis": "^5.10.0",
    "sentiment": "^5.0.2",
    "socket.io-client": "^4.5.1",
    "uuid": "^13.0.0"
  }
}
